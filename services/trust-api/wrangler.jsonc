{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workrr-trust-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  // This worker is transport only. Do not deploy it from CI.
  // database_id and the bucket name are placeholders. Shawn creates the
  // resources and pastes the real database id. See README.md.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workrr-trust",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "workrr-trust-blobs"
    }
  ]
}
