{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workrr-trust-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  // Transport only. Do not deploy it from CI.
  // Replace account_id and database_id before a production deploy.
  // The executable steps are docs/deploy/trust-api-runbook.md.
  // There are no Worker secrets and no plaintext vars.
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {},
  "routes": [
    {
      "pattern": "trust-api.workrr.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workrr-trust",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "workrr-trust-blobs"
    }
  ]
}
