{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workrr-private-anchor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  // Hash-only public anchor log for private-tier certificates.
  // Stores only SHA-256 digests (never artifact names, source URLs, policies, or predicates).
  "account_id": "567f3196420ce625839042b03f9fd706",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {},
  "routes": [
    {
      "pattern": "private-anchor.workrr.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workrr-private-anchor",
      "database_id": "211e74ff-7e4e-4ffd-80bc-e76abec64bf6",
      "migrations_dir": "migrations"
    }
  ]
}
