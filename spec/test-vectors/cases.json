      "files": [
        { "path": "SKILL.md", "text": "---\nname: 'yaml-scalars'\ndescription: >\n  Folded block\n  description.\nlicense: !!str 012\nallowed-tools: [Grep, 012, 0o17, 0x1F, 1e3, +.5, true, TRUE, ~, null, -.inf, .NaN, 1_000, 'Read']\n<<: { extra: merged-only-in-yaml-1.1 }\n---\n" },
        { "path": "LICENCE.txt", "text": "Apache-2.0\n" }
      ]
    },
    {
      "id": "yaml-sequence",
