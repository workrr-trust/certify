{
  "$comment": "Inputs for the cross-implementation test vectors. See README.md. Expected outputs are in expected.json.",
  "canonicalJson": [
    { "b": 1, "a": [true, null, false], "c": {} },
    { "z": [], "": "empty key", "A": 1, "a": 2, "_": 3 },
    { "\uff5e": "fullwidth tilde (U+FF5E) sorts before the emoji in UTF-8 byte order", "\ud83d\ude00": "emoji", "\u00e9": "e-acute", "z": "ascii" },
    { "numbers": [0, -0, 1, -1, 1.5, 0.1, 100, 5000000, 1e21, 1e-7, 1.23e-18, 0.000001, 123456789012345680000, 5e-324, 1.7976931348623157e308, 9007199254740993] },
    { "escapes": "quote\" backslash\\ slash/ \b\f\n\r\t \u0000\u0001\u001f \u007f <&> \u2028\u2029 \ufeff \ud83d\ude00 \u00e9" },
    [[], {}, [{}], {"a": {"b": {"c": [1, {"e": 1, "d": 2}]}}}],
    "a bare string",
    12.5,
    null
  ],
  "policies": {
    "baseline": null,
    "strict-tools": {
      "name": "strict",
      "maxTotalBytes": 5000000,
      "forbiddenExtensions": [".exe", ".dll", ".so", ".dylib", ".bin", ".jar", ".class", ".pyc"],
      "requiredSkillFields": ["name", "description"],
      "allowedTools": ["Grep"]
    },
    "strict-all": {
      "name": "strict-all",
      "maxTotalBytes": 100,
      "forbiddenExtensions": [".exe", ".sh"],
      "requiredSkillFields": ["name", "description", "license"],
      "allowedTools": ["Read", "Grep"],
      "requireLicense": true
    },
    "no-tools": { "name": "no-tools", "allowedTools": [] },
    "unnamed-extra-keys": {
      "maxTotalBytes": 1e21,
      "x-notes": ["unknown keys are part of the digest", 0.1, -0, 1e-7, "\u2028<&>\u0001"],
      "\u043a\u043b\u044e\u0447": { "b": 1, "a": 2 },
      "\uff5e": 1,
      "\ud83d\ude00": 2
    }
  },
  "fixedChecks": {
    "$comment": "provenance and tests depend on git state and on running code, so vectors pin them; policy and scan are computed.",
